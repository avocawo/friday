#!/usr/bin/env python3
"""Friday: task → plan → milestones → final review → draft merge request."""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from friday import card, doctor, journal, milestone, plan, profile, state, status, tasks, tracker, workspace
from friday import serve, service, steps
from friday.errors import FridayError

VERSION = "0.2.0"


def main(argv=None):
    parser = argparse.ArgumentParser(prog="friday", description="Конвейер разработки: от задачи до чернового MR.")
    parser.add_argument("--version", action="version", version="friday " + VERSION)
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("start", help="рабочая копия, план и его проверка другой моделью")
    start.add_argument("key")
    start.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"), required=not os.environ.get("FRIDAY_PROFILE"))
    start.add_argument("--brief", help="файл с постановкой, если задачи нет в трекере")
    start.add_argument("--no-run", action="store_true", help="при approval: auto только утвердить, без запуска")
    start.add_argument("--no-design", action="store_true", help="планировать без макета Figma из профиля")
    for name, text in (("plan", "показать план задачи"), ("run", "исполнить утверждённый план в этом терминале"),
                       ("resume", "продолжить остановленную или упавшую задачу"), ("stop", "остановить идущую задачу")):
        command = commands.add_parser(name, help=text)
        command.add_argument("key")
        if name == "plan":
            command.add_argument("--diff", action="store_true", help="что изменила последняя ревизия плана")
        if name == "resume":
            command.add_argument("--brief", help="восстановить исходную постановку старой задачи по отпечатку планирования")
    approve = commands.add_parser("approve", help="утвердить план и запустить конвейер в фоне")
    approve.add_argument("key")
    approve.add_argument("--no-run", action="store_true", help="только утвердить, не запускать")
    show = commands.add_parser("status", help="что делают задачи сейчас и сколько потрачено")
    show.add_argument("key", nargs="?")
    show.add_argument("--json", action="store_true", help="машиночитаемый вывод")
    decide = commands.add_parser("decide", help="записать решение владельца; план, ждущий утверждения, исправляется по нему")
    decide.add_argument("key")
    decide.add_argument("name")
    decide.add_argument("text")
    decide.add_argument("--reopen", default="", help="вехи, которые решение меняет, через запятую; до утверждения без них вехи выбирает планировщик")
    archive = commands.add_parser("archive", help="убрать рабочую копию и карточку, чтобы начать задачу заново")
    archive.add_argument("key")
    archive.add_argument("--force", action="store_true", help="удалить и незакоммиченные изменения")
    step = commands.add_parser("step", help="выполнить шаг профиля (steps): для задачи — с её ключом, для профиля — с --profile")
    step.add_argument("name", nargs="?", help="без имени — список шагов профиля")
    step.add_argument("key", nargs="?")
    step.add_argument("--list", action="store_true", help="список шагов профиля и их состояние для задачи")
    step.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"))
    step.add_argument("--dry-run", action="store_true", help="показать команду, ничего не запуская")
    commands.add_parser("journal", help="обновить журналы задачи из её карточки").add_argument("key")
    commands.add_parser("serve", help="очередь утверждённых задач машины: запускает их, возвращает упавшие, уведомляет")
    unit = commands.add_parser("service", help="friday serve как служба пользователя: launchd (macOS) или systemd (Linux)")
    unit.add_argument("action", choices=("print", "install", "uninstall", "check"))
    unit.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"), help="для check: профиль для friday doctor")
    check = commands.add_parser("doctor", help="готовность машины и профиля")
    check.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"), required=not os.environ.get("FRIDAY_PROFILE"))
    check.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    root = state.home()
    try:
        return dispatch(root, args)
    except (FridayError, OSError) as exc:
        print("Ошибка: " + str(exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Остановлено.", file=sys.stderr)
        return 130


def launch(root, key, command="run", first=False):
    """Run the pipeline of an approved task in the background — through friday serve's queue when it runs."""
    if serve.running_server(root):
        serve.enqueue(root, key, command, first)
        return "задача в очереди friday serve (%d-я). Ход: friday status %s" % (serve.queue(root).index(key) + 1, key)
    log = card.directory(root, key) / "run.log"
    with open(log, "a") as output:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), command, key], stdout=output, stderr=output,
                         stdin=subprocess.DEVNULL, start_new_session=True, env=dict(os.environ, FRIDAY_HOME=str(root)))
    return "конвейер запущен в фоне (friday serve не запущен). Ход: friday status %s, лог: %s" % (key, log)


def task_profile(root, key):
    return profile.load(card.read(root, key)["profile"])


def decision_report(value, reopened, revised=None):
    """What a decision did to the milestones: revised in the plan, reopened to run again, or only told about it."""
    changed, removed = revised or ([], [])
    told = [item["id"] for item in value["milestones"]
            if item["state"] not in ("done", "running") and item["id"] not in reopened and item["id"] not in changed]
    lines = []
    if changed:
        lines.append("План исправлен (вехи: %s)." % ", ".join(changed))
    if removed:
        lines.append("Убраны из плана (вехи: %s)." % ", ".join(removed))
    if revised is not None and not changed and not removed:
        lines.append("Планировщик не изменил ни одной вехи.")
    if reopened:
        lines.append("Переоткрыты для повторного исполнения (вехи: %s)." % ", ".join(reopened))
    if told:
        lines.append("Только добавлено в контекст вех (%s): их шаги в плане прежние." % ", ".join(told))
    return "\n".join(lines) or "Ни одна веха решение не получит: все выполнены. Чтобы переделать, назовите их в --reopen."


def dispatch(root, args):
    if args.command == "start":
        return start_task(root, args)
    if args.command == "plan":
        print(plan.diff(root, args.key) if args.diff else plan.render(root, args.key))
    elif args.command == "approve":
        plan.approve(root, args.key)
        if args.no_run:
            print("План %s утверждён." % args.key)
        else:
            print("План %s утверждён, %s" % (args.key, launch(root, args.key)))
    elif args.command in ("run", "resume"):
        selected = task_profile(root, args.key)
        if args.command == "resume" and args.brief:
            plan.restore_statement(root, args.key, selected, Path(args.brief).read_text(encoding="utf-8"))
        if args.command == "resume" and serve.running_server(root) and not os.environ.get(serve.CHILD):
            print("Задача %s: %s" % (args.key, launch(root, args.key, "resume")))
            return 0
        result = (milestone.run_task if args.command == "run" else milestone.resume)(root, args.key, selected)
        delivery = result.get("delivery") or {}
        print("Вех готово: %d. Осталось: %s" % (len(result["completed"]), ", ".join(result["left"]) or "нет"))
        if delivery.get("url"):
            print("Черновой MR: " + delivery["url"])
        elif delivery.get("description"):
            print("Текст MR: " + delivery["description"])
    elif args.command == "stop":
        if serve.dequeue(root, args.key) and not serve.active(card.read(root, args.key)):
            print("Задача %s убрана из очереди friday serve." % args.key)
        else:
            print("Задаче %s отправлен сигнал остановки (процесс %d)." % (args.key, tasks.stop(root, args.key)))
    elif args.command == "serve":
        serve.serve(root)
    elif args.command == "service":
        if args.action == "print":
            path, text = service.render(root)
            print("# %s\n%s" % (path, text))
        elif args.action == "install":
            print("Служба установлена: %s. Журнал: %s" % (service.install(root), root / "serve.log"))
        elif args.action == "uninstall":
            print("Служба убрана: %s" % service.uninstall())
        else:
            if not args.profile:
                raise FridayError("invalid_state", "Pass --profile for friday doctor.")
            code, output = service.check(root, args.profile)
            print("friday doctor в окружении службы:\n" + output)
            return code
    elif args.command == "decide":
        named = [x for x in args.reopen.split(",") if x]
        reopened = milestone.decide(root, args.key, args.name, args.text, named)
        print("Решение записано.")
        selected = task_profile(root, args.key)
        value = card.read(root, args.key)
        if value["state"] == "awaiting_approval":
            if profile.toolset(selected, "plan") == "project":
                before = milestone.load_plan(root, args.key)
                # The project's planning session continues with the answer.
                revised = plan.changes(before, plan.answer(root, args.key, selected, args.text))
            else:
                revised = plan.amend(root, args.key, selected, args.text, named)  # ADR 0016
            print(plan.render(root, args.key) + "\n\n" + decision_report(card.read(root, args.key), reopened, revised) +
                  ("\nЧто изменилось: friday plan %s --diff" % args.key if any(revised) else "") +
                  "\nУтвердить и запустить: friday approve " + args.key)
            return 0
        print(decision_report(value, reopened))
        if value["state"] == "stopped" and value.get("questions") and profile.toolset(selected, "execute") == "project":
            # The project's execution session continues with the answer in the background, as approve starts it.
            card.update(root, args.key, lambda current: current.update(pending_answer=args.text))
            print("Ответ передан сессии исполнения, " + launch(root, args.key, first=True))
    elif args.command == "archive":
        result = tasks.archive(root, args.key, task_profile(root, args.key), force=args.force)
        print("Задача в архиве: %s. Ветка %s сохранена." % (result["archive"], result["branch"]))
    elif args.command == "journal":
        written = journal.sync(root, args.key)
        print("\n".join(written) if written else "В профиле не настроены журналы (journal или journal_dir).")
    elif args.command == "doctor":
        report = doctor.inspect(args.profile)
        print(json.dumps(report, ensure_ascii=False, indent=2) if args.json else doctor.render(report))
        return 0 if report["ready"] else 1
    elif args.command == "step":
        if args.list and args.name and not args.key:
            args.name, args.key = None, args.name  # friday step --list KEY
        if not args.key and not args.profile:
            raise FridayError("invalid_state", "Pass the task key or --profile.")
        selected = task_profile(root, args.key) if args.key else profile.load(args.profile)
        if args.list or not args.name:
            print(steps.listing(selected, card.read(root, args.key) if args.key else None))
        else:
            print(steps.text(steps.run(root, selected, args.name, args.key, dry_run=args.dry_run)))
    elif args.command == "status":
        if args.json:
            print(json.dumps(status.task(root, args.key) if args.key else status.overview(root), ensure_ascii=False, indent=2))
        else:
            print(status.render_task(root, args.key) if args.key else
                  status.render(status.overview(root)) + "\n\n" + status.server_line(root))
    return 0


def start_task(root, args):
    selected = profile.load(args.profile)
    try:
        existing = card.read(root, args.key)
    except FridayError as exc:
        if exc.code != "not_found":
            raise
        existing = card.create(root, args.key, selected["path"])
    if existing["state"] not in ("planning", "failed"):
        raise FridayError("invalid_state", "Task %s is already %s." % (args.key, existing["state"]))
    try:
        workspace.create(root, args.key, selected)
        if args.brief:
            ticket = Path(args.brief).read_text(encoding="utf-8")
        else:
            ticket = tracker.ticket(selected, args.key)
            if ticket is None:
                raise FridayError("ticket_missing", "The profile has no tracker; pass --brief with the task statement.")
        plan.make(root, args.key, selected, ticket, use_design=not args.no_design)
    except (FridayError, OSError) as exc:
        card.update(root, args.key, lambda value: value.update(state="failed"))
        card.record(root, args.key, "start_failed", error=str(exc))
        raise
    print(plan.render(root, args.key))
    if selected.get("approval") == "auto":
        plan.approve(root, args.key, by="auto")
        print("\nПлан утверждён автоматически (approval: auto), " + (launch(root, args.key) if not args.no_run else "запуск: friday run " + args.key))
    else:
        print("\nУтвердить и запустить: friday approve " + args.key)
    return 0


if __name__ == "__main__":
    sys.exit(main())
