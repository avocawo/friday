#!/usr/bin/env python3
"""Friday: task → plan → milestones → final review → draft merge request."""
import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from friday import card, doctor, milestone, plan, profile, state, status, tasks, tracker, workspace
from friday.errors import FridayError

VERSION = "0.2.0"


def main(argv=None):
    parser = argparse.ArgumentParser(prog="friday", description="Конвейер разработки: от задачи до чернового MR.")
    parser.add_argument("--version", action="version", version="friday " + VERSION)
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser("start", help="рабочая копия, план и его проверка другой моделью")
    start.add_argument("key")
    start.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"), required=not os.environ.get("FRIDAY_PROFILE"))
    start.add_argument("--brief", help="файл с постановкой, если задачи нет в трекере")
    for name, text in (("plan", "показать план задачи"), ("run", "исполнить утверждённый план в этом терминале"),
                       ("resume", "продолжить остановленную или упавшую задачу"), ("stop", "остановить идущую задачу")):
        commands.add_parser(name, help=text).add_argument("key")
    approve = commands.add_parser("approve", help="утвердить план и запустить конвейер в фоне")
    approve.add_argument("key")
    approve.add_argument("--no-run", action="store_true", help="только утвердить, не запускать")
    show = commands.add_parser("status", help="что делают задачи сейчас и сколько потрачено")
    show.add_argument("key", nargs="?")
    show.add_argument("--json", action="store_true", help="машиночитаемый вывод")
    decide = commands.add_parser("decide", help="записать решение владельца")
    decide.add_argument("key")
    decide.add_argument("name")
    decide.add_argument("text")
    decide.add_argument("--reopen", default="", help="вехи, которые решение меняет, через запятую")
    archive = commands.add_parser("archive", help="убрать рабочую копию и карточку, чтобы начать задачу заново")
    archive.add_argument("key")
    archive.add_argument("--force", action="store_true", help="удалить и незакоммиченные изменения")
    check = commands.add_parser("doctor", help="готовность машины и профиля")
    check.add_argument("--profile", default=os.environ.get("FRIDAY_PROFILE"), required=not os.environ.get("FRIDAY_PROFILE"))
    check.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    root = state.home()
    try:
        return dispatch(root, args)
    except (FridayError, OSError) as exc:
        print("Ошибка: " + str(exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Остановлено.", file=sys.stderr)
        return 130


def task_profile(root, key):
    return profile.load(card.read(root, key)["profile"])


def dispatch(root, args):
    if args.command == "start":
        return start_task(root, args)
    if args.command == "plan":
        print(plan.render(root, args.key))
    elif args.command == "approve":
        plan.approve(root, args.key)
        if args.no_run:
            print("План %s утверждён." % args.key)
        else:
            log = card.directory(root, args.key) / "run.log"
            with open(log, "a") as output:
                subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "run", args.key], stdout=output, stderr=output,
                                 stdin=subprocess.DEVNULL, start_new_session=True, env=dict(os.environ, FRIDAY_HOME=str(root)))
            print("План %s утверждён, конвейер запущен в фоне. Ход: friday status %s, лог: %s" % (args.key, args.key, log))
    elif args.command in ("run", "resume"):
        selected = task_profile(root, args.key)
        result = (milestone.run_task if args.command == "run" else milestone.resume)(root, args.key, selected)
        delivery = result.get("delivery") or {}
        print("Вех готово: %d. Осталось: %s" % (len(result["completed"]), ", ".join(result["left"]) or "нет"))
        if delivery.get("url"):
            print("Черновой MR: " + delivery["url"])
        elif delivery.get("description"):
            print("Текст MR: " + delivery["description"])
    elif args.command == "stop":
        print("Задаче %s отправлен сигнал остановки (процесс %d)." % (args.key, tasks.stop(root, args.key)))
    elif args.command == "decide":
        reopened = milestone.decide(root, args.key, args.name, args.text, [x for x in args.reopen.split(",") if x])
        print("Решение записано. Переоткрыты: " + (", ".join(reopened) or "ничего"))
    elif args.command == "archive":
        result = tasks.archive(root, args.key, task_profile(root, args.key), force=args.force)
        print("Задача в архиве: %s. Ветка %s сохранена." % (result["archive"], result["branch"]))
    elif args.command == "doctor":
        report = doctor.inspect(args.profile)
        print(json.dumps(report, ensure_ascii=False, indent=2) if args.json else doctor.render(report))
        return 0 if report["ready"] else 1
    elif args.command == "status":
        if args.json:
            print(json.dumps(status.task(root, args.key) if args.key else status.overview(root), ensure_ascii=False, indent=2))
        else:
            print(status.render_task(root, args.key) if args.key else status.render(status.overview(root)))
    return 0


def start_task(root, args):
    selected = profile.load(args.profile)
    try:
        existing = card.read(root, args.key)
    except FridayError as exc:
        if exc.code != "not_found":
            raise
        existing = card.create(root, args.key, selected["path"])
    if existing["state"] not in ("planning", "failed"):
        raise FridayError("invalid_state", "Task %s is already %s." % (args.key, existing["state"]))
    try:
        workspace.create(root, args.key, selected)
        if args.brief:
            ticket = Path(args.brief).read_text(encoding="utf-8")
        else:
            ticket = tracker.ticket(selected, args.key)
            if ticket is None:
                raise FridayError("ticket_missing", "The profile has no tracker; pass --brief with the task statement.")
        plan.make(root, args.key, selected, ticket)
    except (FridayError, OSError) as exc:
        card.update(root, args.key, lambda value: value.update(state="failed"))
        card.record(root, args.key, "start_failed", error=str(exc))
        raise
    print(plan.render(root, args.key))
    print("\nУтвердить и запустить: friday approve " + args.key)
    return 0


if __name__ == "__main__":
    sys.exit(main())
